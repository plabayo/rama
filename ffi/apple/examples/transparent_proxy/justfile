set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]
set working-directory := '.'

xcode_derived_data_dev := "./.xcode-derived/tproxy-app-dev"
xcode_derived_data_dist := "./.xcode-derived/tproxy-app-dist"
xcode_configuration_dev := env_var_or_default("RAMA_TPROXY_CONFIGURATION", "Debug")
tproxy_built_app_dev := xcode_derived_data_dev + "/Build/Products/" + xcode_configuration_dev + "/RamaTransparentProxyExampleContainer.app"
tproxy_built_app_dist := xcode_derived_data_dist + "/Build/Products/Release/RamaTransparentProxyExampleContainer.app"

[working-directory: './tproxy_rs']
build-tproxy-rs:
    cargo build --target aarch64-apple-darwin &&     cargo build --target x86_64-apple-darwin &&     mkdir -p target/universal &&     lipo -create         -output target/universal/librama_tproxy_example.a         target/aarch64-apple-darwin/debug/librama_tproxy_example.a         target/x86_64-apple-darwin/debug/librama_tproxy_example.a

build-tproxy-app-dev:
    ./scripts/build_tproxy_app_with_signing.sh

build-tproxy-app-dist:
    ./scripts/build_tproxy_app_with_developer_id_signing.sh

notarize-tproxy-app-dist:
    ./scripts/notarize_tproxy_app_with_developer_id_signing.sh

install-tproxy-app-dev:
    ./scripts/build_tproxy_app_with_signing.sh
    INSTALLED_APP=/Applications/RamaTransparentProxyExampleContainer.app; \
    INSTALLED_SYSEXT="$INSTALLED_APP/Contents/Library/SystemExtensions/org.ramaproxy.example.tproxy.dev.provider.systemextension"; \
    ./scripts/install_tproxy_app_bundle.sh dev "{{tproxy_built_app_dev}}" 0 && \
    echo "Installed Development system extension bundle at $INSTALLED_SYSEXT"

install-tproxy-app-dist:
    ./scripts/notarize_tproxy_app_with_developer_id_signing.sh
    INSTALLED_APP=/Applications/RamaTransparentProxyExampleContainer.app; \
    INSTALLED_SYSEXT="$INSTALLED_APP/Contents/Library/SystemExtensions/org.ramaproxy.example.tproxy.dist.provider.systemextension"; \
    ./scripts/install_tproxy_app_bundle.sh dist "{{tproxy_built_app_dist}}" 0 && \
    echo "Installed Developer ID system extension bundle at $INSTALLED_SYSEXT"

install-tproxy-app-dev-reset-profile:
    ./scripts/build_tproxy_app_with_signing.sh
    INSTALLED_APP=/Applications/RamaTransparentProxyExampleContainer.app; \
    INSTALLED_SYSEXT="$INSTALLED_APP/Contents/Library/SystemExtensions/org.ramaproxy.example.tproxy.dev.provider.systemextension"; \
    ./scripts/install_tproxy_app_bundle.sh dev "{{tproxy_built_app_dev}}" 1 && \
    echo "Installed Development system extension bundle at $INSTALLED_SYSEXT"

install-tproxy-app-dist-reset-profile:
    ./scripts/notarize_tproxy_app_with_developer_id_signing.sh
    INSTALLED_APP=/Applications/RamaTransparentProxyExampleContainer.app; \
    INSTALLED_SYSEXT="$INSTALLED_APP/Contents/Library/SystemExtensions/org.ramaproxy.example.tproxy.dist.provider.systemextension"; \
    ./scripts/install_tproxy_app_bundle.sh dist "{{tproxy_built_app_dist}}" 1 && \
    echo "Installed Developer ID system extension bundle at $INSTALLED_SYSEXT"

build-tproxy-dev: build-tproxy-app-dev

build-tproxy-dist: build-tproxy-app-dist

build-tproxy: build-tproxy-dev build-tproxy-dist

notarize-tproxy-dist: notarize-tproxy-app-dist

clear-tproxy-files:
    sudo rm -rf "/var/root/Library/Application Support/rama/tproxy/dial9-traces"

install-tproxy-dev: clear-tproxy-files install-tproxy-app-dev

install-tproxy-dev-reset-profile: install-tproxy-app-dev-reset-profile

install-tproxy-dist: clear-tproxy-files install-tproxy-app-dist

install-tproxy-dist-reset-profile: install-tproxy-app-dist-reset-profile

clean: clean-rust clean-swift clean-xcode

clean-rust:
    cargo clean --manifest-path ./tproxy_rs/Cargo.toml
    cargo clean --manifest-path ./tproxy_ffi_e2e/Cargo.toml

clean-swift:
    @just _clean-swift-{{os_family()}}

_clean-swift-unix:
    @if command -v swift >/dev/null 2>&1; then \
        swift package --package-path ../../../.. clean; \
    fi

_clean-swift-windows:
    if (Get-Command swift -ErrorAction SilentlyContinue) { swift package --package-path ../../../.. clean }

clean-xcode:
    @just _clean-xcode-{{os_family()}}

_clean-xcode-unix:
    rm -rf -- ./.xcode-derived ./tproxy_app/RamaTransparentProxyExample.xcodeproj

_clean-xcode-windows:
    Remove-Item -Recurse -Force -ErrorAction SilentlyContinue ./.xcode-derived, ./tproxy_app/RamaTransparentProxyExample.xcodeproj

clippy *ARGS:
    cd ./tproxy_rs && cargo clippy --all-targets --all-features {{ARGS}}
    cd ./tproxy_ffi_e2e && cargo clippy --all-targets --all-features {{ARGS}}

sort:
    @command -v cargo-sort >/dev/null || cargo install cargo-sort --locked
    cd ./tproxy_rs && cargo sort --workspace --grouped
    cd ./tproxy_ffi_e2e && cargo sort --workspace --grouped

[working-directory: './tproxy_rs']
clippy-fix *ARGS:
    just clippy --fix {{ARGS}}

[working-directory: './tproxy_rs']
rust-doc *ARGS:
    cargo doc --all-features --no-deps {{ARGS}}

[working-directory: './tproxy_rs']
rust-test *ARGS:
    @command -v cargo-nextest >/dev/null || cargo install cargo-nextest --locked
    cargo nextest run --all-features --no-tests=pass {{ARGS}}

[working-directory: './tproxy_rs']
rust-test-ignored:
    @command -v cargo-nextest >/dev/null || cargo install cargo-nextest --locked
    cargo nextest run --all-features --run-ignored=only --no-tests=pass

[working-directory: './tproxy_rs']
build-tproxy-rs-debug:
    cargo build

update-deps:
    @cargo install cargo-edit --locked
    cd ./tproxy_rs && cargo upgrade --incompatible && cargo update && cargo generate-lockfile
    cd ./tproxy_ffi_e2e && cargo upgrade --incompatible && cargo update && cargo generate-lockfile

[working-directory: './tproxy_ffi_e2e']
clippy-tproxy-ffi-e2e:
    cargo clippy --all-targets -- -D warnings

[working-directory: './tproxy_ffi_e2e']
cleanup-tproxy-ffi-e2e:
    pkill -f 'transparent_proxy/tproxy_ffi_e2e/target/.*/deps/e2e-' >/dev/null 2>&1 || true

[working-directory: './tproxy_ffi_e2e']
run-tproxy-ffi-e2e:
    cargo test --test e2e -- --test-threads=1 --nocapture

[working-directory: '.']
run-tproxy-ffi-e2e-swift: build-tproxy-rs-debug
    swift test \
        -Xlinker -L$(pwd)/tproxy_rs/target/debug \
        -Xlinker -lrama_tproxy_example \
        -Xlinker -lz \
        -Xlinker -framework -Xlinker NetworkExtension \
        -Xlinker -framework -Xlinker SystemConfiguration

# First compile the ordinary uninstrumented Release products. The optimized
# test suite then explicitly enables the existing state/scheduling observation
# seams without defining DEBUG or enabling Swift debug assertions. Production
# Release app builds omit RAMA_TESTING and keep those seams compiled out.
[working-directory: '.']
run-tproxy-ffi-e2e-swift-release: build-tproxy-rs-debug
    swift build -c release
    swift test -c release -Xswiftc -DRAMA_TESTING \
        -Xlinker -L$(pwd)/tproxy_rs/target/debug \
        -Xlinker -lrama_tproxy_example \
        -Xlinker -lz \
        -Xlinker -framework -Xlinker NetworkExtension \
        -Xlinker -framework -Xlinker SystemConfiguration

# Full Swift unit suite under ThreadSanitizer. Suppressions are deliberately
# forbidden: any reported Swift-side race must fail this recipe. The linked
# Rust static library is not instrumented by this Swift TSan invocation.
[working-directory: '.']
run-tproxy-ffi-e2e-swift-tsan: build-tproxy-rs-debug
    TSAN_OPTIONS="halt_on_error=1:exitcode=66" \
    swift test --sanitize=thread \
        -Xlinker -L$(pwd)/tproxy_rs/target/debug \
        -Xlinker -lrama_tproxy_example \
        -Xlinker -lz \
        -Xlinker -framework -Xlinker NetworkExtension \
        -Xlinker -framework -Xlinker SystemConfiguration

qa-rust: sort clippy rust-doc rust-test rust-test-ignored

check-spec-parity:
    ./scripts/check_spec_parity.sh

lint-scripts:
    shellcheck ./scripts/*.sh

test-tools: lint-scripts
    python3 ./scripts/test_tools.py

qa: qa-rust check-spec-parity test-tools build-tproxy-dev

test-e2e: build-tproxy-rs-debug clippy-tproxy-ffi-e2e cleanup-tproxy-ffi-e2e run-tproxy-ffi-e2e run-tproxy-ffi-e2e-swift

test-full: qa test-e2e

# Run the Rust FFI e2e suite under AddressSanitizer to surface memory errors,
# including use-after-free. ASan does not detect data races.
#
# Requires nightly Rust (`rustup toolchain install nightly`). The static lib
# (`tproxy_rs`) and the test crate (`tproxy_ffi_e2e`) must both be built with
# the sanitizer flag, otherwise memory accesses across that boundary are not
# fully instrumented. Run every FFI case, including the UDP ownership,
# backpressure, and 8,192-session cases as well as the churn scenarios.
# Disable the example's default jemalloc feature so allocator symbols agree
# with the test driver and ASan intercepts heap allocation and deallocation.
[working-directory: './tproxy_rs']
build-tproxy-rs-asan:
    RUSTFLAGS="-Z sanitizer=address -D warnings --cfg tokio_unstable" \
        cargo +nightly build --locked --no-default-features --target-dir target/asan --target aarch64-apple-darwin

[working-directory: './tproxy_ffi_e2e']
run-tproxy-ffi-e2e-asan:
    RUSTFLAGS="-Z sanitizer=address -D warnings --cfg tokio_unstable" \
        RAMA_TPROXY_EXAMPLE_LIB_DIR="../tproxy_rs/target/asan/aarch64-apple-darwin/debug" \
        cargo +nightly test --target-dir target/asan --target aarch64-apple-darwin \
        --test e2e -- --test-threads=1 --nocapture

# Convenience target: build the staticlib with ASan and run the e2e stress
# cases under it. Slower than `test-e2e` and requires nightly.
test-e2e-asan: build-tproxy-rs-asan run-tproxy-ffi-e2e-asan

# Complementary sanitizer passes: Rust ASan memory-safety stress plus Swift-side
# TSan. This does not provide TSan race coverage for the linked Rust staticlib.
test-e2e-sanitizers: test-e2e-asan run-tproxy-ffi-e2e-swift-tsan

# Generate HTTP traffic through the running proxy; use --help for workload options.
stress-traffic *ARGS:
    python3 ./scripts/stress_traffic.py {{ARGS}}
