# CI linting and executable helpers.
# Run from the repository root with `just scripts/ci/<recipe>`.
# Python runs in the shared locked stdlib-only environment here.

set working-directory := '../..'

# rama's own tracing level, which the root justfile exports, is read by uv as well and would
# bury these checks' output. Clearing it here covers both a direct call and one that inherits
# the root's environment.
export RUST_LOG := ""

[private]
default:
    @just --list --justfile {{ justfile() }}

# Lint workflows and test executable CI helpers.
qa: lint test

# actionlint currently needs this exception for GitHub's queue setting.
lint:
    actionlint -ignore 'unexpected key "queue" for "concurrency" section'

# Test helper behavior; workflow files themselves are the CI contract.
test:
    uv run --frozen --project scripts/ci python -m unittest discover -s scripts/ci -p 'test_*.py'

# Newest standard Apple preview runner from GitHub's catalog.
apple-preview-runner:
    uv run --frozen --project scripts/ci python scripts/ci/apple_preview_runner.py

# Bound disk use across the disposable Apple preview runner’s checks.
apple-preview-phase PHASE +COMMAND:
    uv run --frozen --project scripts/ci python scripts/ci/apple_preview_phase.py {{PHASE}} {{COMMAND}}
