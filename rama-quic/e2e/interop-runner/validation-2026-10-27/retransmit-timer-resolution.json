    "patch": "diff --git a/rama-quic/src/proto/connection/send_buffer.rs b/rama-quic/src/proto/connection/send_buffer.rs\nindex 2004d6a0b..6e70c5fcd 100644\n--- a/rama-quic/src/proto/connection/send_buffer.rs\n+++ b/rama-quic/src/proto/connection/send_buffer.rs\n@@ -199,13 +199,15 @@ impl SendBuffer {\n         range.start = range.start.max(self.offset - self.unacked_len as u64);\n         let (start, end) = (range.start, range.end);\n         self.retransmits.insert(range);\n-        for acked in self\n-            .acks\n-            .iter()\n-            .skip_while(|acked| acked.end <= start)\n-            .take_while(|acked| acked.start < end)\n-        {\n-            self.retransmits.remove(acked);\n+        if !self.acks.is_empty() {\n+            for acked in self\n+                .acks\n+                .iter()\n+                .skip_while(|acked| acked.end <= start)\n+                .take_while(|acked| acked.start < end)\n+            {\n+                self.retransmits.remove(acked);\n+            }\n         }\n     }\n \n"
